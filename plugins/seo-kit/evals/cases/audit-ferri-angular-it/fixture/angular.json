{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "studio-ferri": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/studio-ferri",
            "browser": "src/main.ts",
            "server": "src/main.server.ts",
            "outputMode": "static",
            "prerender": true
          }
        }
      }
    }
  }
}
